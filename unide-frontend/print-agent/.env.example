# =====================================================================
# Configuracion del agente de impresion HIPERA
# =====================================================================
# Copia este archivo a ".env" (sin .example) y rellena los valores.
# NO subas el .env a ningun sitio: contiene el token.

# URL del backend en Railway (sin barra final).
BACKEND_URL=https://hipera-shop-production.up.railway.app

# Token compartido con el backend. DEBE ser EXACTAMENTE el mismo valor
# que la variable PRINT_AGENT_TOKEN configurada en Railway.
PRINT_AGENT_TOKEN=pega_aqui_el_mismo_token_que_en_railway

# Nombre EXACTO de la impresora en Windows (Panel de control >
# Dispositivos e impresoras). Por defecto el driver de la XP-80T es "XP-80C".
PRINTER_NAME=XP-80C

# Cada cuantos milisegundos consulta pedidos nuevos (10000 = 10 s).
POLL_INTERVAL_MS=10000

# --- Zumbador (buzzer) ---
# Comando ESC B n t. n = numero de pitidos (1-9), t = duracion (1-9, x50ms).
# Si tu modelo no pita, prueba a cambiar estos valores o pon BUZZER_ENABLED=false.
BUZZER_ENABLED=true
BUZZER_COUNT=3
BUZZER_DURATION=3

# Abrir el cajon portamonedas al imprimir (true/false). Por defecto NO.
OPEN_DRAWER=false

# Ancho del papel en caracteres (80mm Font A = 48). No suele hacer falta tocarlo.
PRINT_WIDTH=48

# --- Cabecera del ticket (datos de la tienda) ---
# Por defecto ya trae los datos de HIPERA; cambialos solo si hace falta.
STORE_NAME=HIPERA
STORE_ADDRESS_1=Paseo del Sol 1
STORE_ADDRESS_2=28880 Meco, Madrid
STORE_PHONE=+34 918 782 602
