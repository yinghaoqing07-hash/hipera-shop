{
  "regions": ["cdg1"],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://hipera-shop-production.up.railway.app/api/:path*"
    },
    {
      "source": "/repair",
      "destination": "/repair.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}