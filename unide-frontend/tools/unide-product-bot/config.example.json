{
  "telegram": {
    "allowedChatIds": [],
    "pollTimeoutSeconds": 25,
    "maxItemsPerMessage": 5
  },
  "supplierCsv": "data/supplier_products_clean.csv",
  "storeCsv": "data/store_products_clean.csv",
  "logsDir": "logs",
  "processing": {
    "defaultIva": 10
  },
  "ordering": {
    "enabled": true,
    "timezone": "Europe/Madrid",
    "reminderTime": "10:00",
    "reminderWindowMinutes": 180,
    "reminderChatIds": []
  },
  "arrival": {
    "enabled": true,
    "printTime": "08:30",
    "windowMinutes": 180,
    "offsetDays": 2,
    "printerName": "",
    "autoPrint": true,
    "chatIds": [],
    "excludeStates": [
      "Alta"
    ],
    "maxOrders": 8
  },
  "promotions": {
    "listUrl": "",
    "candidatePaths": [],
    "maxPreview": 25,
    "maxPages": 50,
    "maxDetailPromotions": 500,
    "detailOpenMs": 400,
    "pageTurnMs": 1200,
    "detailPageTurnMs": 1600,
    "detailRowsTimeoutMs": 9000,
    "outputDir": "promotions"
  },
  "desktop": {
    "enabled": false,
    "script": "desktop/unideges-search.ps1",
    "windowTitleRegex": "UNIDEGES|Articulos|Artículos",
    "excludedProcessNames": [
      "chrome",
      "msedge",
      "firefox"
    ],
    "screenshotDir": "screenshots",
    "expectedScreen": {
      "width": 0,
      "height": 0
    },
    "clearSteps": [],
    "steps": [],
    "codeSearchSteps": [
      {
        "type": "focus"
      },
      {
        "type": "uiaClickMsg",
        "classRegex": "ToolbarWindow32",
        "offsetX": 376,
        "offsetY": 15,
        "name": "Vaciar pantalla (clic por mensajes al botón de la barra; offset relativo a la barra)"
      },
      {
        "type": "wait",
        "ms": 600
      },
      {
        "type": "closeDialog",
        "keys": "n",
        "name": "Si vaciar pregunta '¿guardar?', responder NO (no arrastrar basura de pruebas)"
      },
      {
        "type": "uiaSet",
        "label": "Código",
        "value": "{{query}}"
      },
      {
        "type": "hotkey",
        "keys": "{F3}"
      },
      {
        "type": "wait",
        "ms": 2000
      },
      {
        "type": "closeDialog",
        "name": "Aviso inútil post-búsqueda (Alt+F4); sin aviso no hace nada"
      },
      {
        "type": "listSelectLast",
        "classRegex": "SysListView32",
        "name": "Seleccionar la fila TIENDA (la última)"
      },
      {
        "type": "wait",
        "ms": 800
      },
      {
        "type": "screenshot",
        "name": "Artículo cargado, registro TIENDA"
      }
    ],
    "orderApplySteps": [
      {
        "type": "focus"
      },
      {
        "type": "click",
        "name": "Nuevo pedido",
        "x": 327,
        "y": 177
      },
      {
        "type": "wait",
        "ms": 1000
      },
      {
        "type": "setField",
        "name": "Nombre del Pedido",
        "x": 486,
        "y": 267,
        "value": "{{orderName}}"
      },
      {
        "type": "wait",
        "ms": 300
      },
      {
        "type": "click",
        "name": "Primera linea articulo",
        "x": 694,
        "y": 615
      },
      {
        "type": "wait",
        "ms": 200
      },
      {
        "type": "orderLines",
        "selectKeys": "{ENTER}",
        "quantityKeys": "{TAB}",
        "finishLineKeys": "{ENTER}{ENTER}",
        "autocompleteMs": 700,
        "selectedMs": 300,
        "betweenLinesMs": 700
      },
      {
        "type": "screenshot",
        "name": "Order filled screenshot"
      }
    ],
    "priceReadSteps": [
      {
        "type": "focus"
      },
      {
        "type": "listSelectLast",
        "classRegex": "SysListView32"
      },
      {
        "type": "wait",
        "ms": 600
      },
      {
        "type": "uiaRead",
        "nameRegex": "^(SDC|TIENDA)$",
        "name": "bancoDatos"
      },
      {
        "type": "uiaRead",
        "label": "Código",
        "name": "codigoPantalla"
      },
      {
        "type": "uiaRead",
        "label": "PC Medio",
        "name": "pcMedio"
      },
      {
        "type": "uiaRead",
        "label": "PC Ultimo",
        "name": "pcUltimo"
      },
      {
        "type": "uiaRead",
        "label": "Bloq.Venta",
        "self": true,
        "checkbox": true,
        "name": "bloqVentaChecked"
      },
      {
        "type": "screenshot",
        "name": "Price read screenshot"
      }
    ],
    "priceApplySteps": [
      {
        "type": "focus"
      },
      {
        "type": "uiaSelectIfEmpty",
        "label": "Proveedor",
        "index": 0,
        "value": "4214",
        "name": "PRIMERO con el objeto limpio: proveedor por defecto 4214 (don fruta), solo si vacío"
      },
      {
        "type": "closeDialog",
        "keys": "{ENTER}"
      },
      {
        "type": "uiaSelectIfEmpty",
        "label": "Proveedor",
        "index": 1,
        "value": "don fruta"
      },
      {
        "type": "uiaSelectIfEmpty",
        "label": "Inventariable",
        "value": "s",
        "name": "Prefijo s casa con Sí"
      },
      {
        "type": "uiaSet",
        "label": "PC Medio",
        "value": "{{pcMedio}}"
      },
      {
        "type": "uiaSet",
        "label": "PC Ultimo",
        "value": "{{pcUltimo}}"
      },
      {
        "type": "uiaSet",
        "label": "P. defecto",
        "index": 1,
        "value": "{{pDefecto}}",
        "name": "Columna %"
      },
      {
        "type": "uiaKey",
        "label": "P. defecto",
        "index": 1,
        "vk": "F2",
        "name": "F2 en el campo: recalcula el P.TPV (escribir el % no lo dispara solo)"
      },
      {
        "type": "wait",
        "ms": 500
      },
      {
        "type": "uiaToggleIf",
        "label": "Bloq.Venta",
        "self": true,
        "if": "bloqVentaChecked",
        "name": "AL FINAL: desmarcar solo si estaba marcado (estado por MSAA, fiable)"
      },
      {
        "type": "wait",
        "ms": 400
      },
      {
        "type": "screenshot",
        "name": "MODO PRUEBAS: SIN Ctrl+S — revisar la captura y guardar A MANO. Para reactivar el guardado, añadir aquí hotkey ^s + closeDialog {ENTER}"
      }
    ]
  },
  "webOrder": {
    "enabled": false,
    "debugUrl": "http://127.0.0.1:9222",
    "pageUrlIncludes": "unideges",
    "dumpFile": "order-page-dump.html",
    "formRenderMs": 2800,
    "autocompleteTimeoutMs": 5000,
    "autocompleteMs": 900,
    "betweenLinesMs": 400,
    "pageNavigationTimeoutMs": 20000,
    "pedidoListUrl": "",
    "maxSearchOptions": 20,
    "protocolTimeoutMs": 90000,
    "connectRetries": 3,
    "selectSettleMs": 500,
    "repairBlankLines": true,
    "nextFieldMs": 140
  }
}
