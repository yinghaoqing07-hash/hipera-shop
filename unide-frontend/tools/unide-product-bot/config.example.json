{
  "telegram": {
    "allowedChatIds": [],
    "pollTimeoutSeconds": 25,
    "maxItemsPerMessage": 5
  },
  "supplierCsv": "data/supplier_products_clean.csv",
  "storeCsv": "data/store_products_clean.csv",
  "logsDir": "logs",
  "processing": {
    "defaultIva": 10
  },
  "ordering": {
    "enabled": true,
    "timezone": "Europe/Madrid",
    "reminderTime": "10:00",
    "reminderWindowMinutes": 180,
    "reminderChatIds": []
  },
  "arrival": {
    "enabled": true,
    "printTime": "08:30",
    "windowMinutes": 180,
    "offsetDays": 2,
    "printerName": "",
    "autoPrint": true,
    "chatIds": [],
    "excludeStates": [
      "Alta"
    ],
    "maxOrders": 8
  },
  "promotions": {
    "listUrl": "",
    "candidatePaths": [],
    "maxPreview": 25,
    "maxPages": 50,
    "maxDetailPromotions": 500,
    "detailOpenMs": 400,
    "pageTurnMs": 1200,
    "detailPageTurnMs": 1600,
    "detailRowsTimeoutMs": 9000,
    "outputDir": "promotions"
  },
  "desktop": {
    "enabled": false,
    "script": "desktop/unideges-search.ps1",
    "windowTitleRegex": "UNIDEGES|Articulos|Artículos",
    "excludedProcessNames": [
      "chrome",
      "msedge",
      "firefox"
    ],
    "screenshotDir": "screenshots",
    "expectedScreen": {
      "width": 0,
      "height": 0
    },
    "clearSteps": [],
    "steps": [],
    "codeSearchSteps": [
      {
        "type": "focus"
      },
      {
        "type": "uiaFocus",
        "label": "Código",
        "name": "Foco directo al campo Código (por etiqueta, sin coordenadas)"
      },
      {
        "type": "hotkey",
        "keys": "^a"
      },
      {
        "type": "typeText",
        "value": "{{query}}"
      },
      {
        "type": "hotkey",
        "keys": "{F3}",
        "name": "F3 = Buscar"
      },
      {
        "type": "wait",
        "ms": 2000
      },
      {
        "type": "closeDialog",
        "name": "Solo actúa si apareció una ventana nueva"
      },
      {
        "type": "screenshot",
        "name": "Artículo cargado por código"
      }
    ],
    "orderApplySteps": [
      {
        "type": "focus"
      },
      {
        "type": "click",
        "name": "Nuevo pedido",
        "x": 327,
        "y": 177
      },
      {
        "type": "wait",
        "ms": 1000
      },
      {
        "type": "setField",
        "name": "Nombre del Pedido",
        "x": 486,
        "y": 267,
        "value": "{{orderName}}"
      },
      {
        "type": "wait",
        "ms": 300
      },
      {
        "type": "click",
        "name": "Primera linea articulo",
        "x": 694,
        "y": 615
      },
      {
        "type": "wait",
        "ms": 200
      },
      {
        "type": "orderLines",
        "selectKeys": "{ENTER}",
        "quantityKeys": "{TAB}",
        "finishLineKeys": "{ENTER}{ENTER}",
        "autocompleteMs": 700,
        "selectedMs": 300,
        "betweenLinesMs": 700
      },
      {
        "type": "screenshot",
        "name": "Order filled screenshot"
      }
    ],
    "priceReadSteps": [
      {
        "type": "focus"
      },
      {
        "type": "uiaRead",
        "label": "Código",
        "name": "codigoPantalla"
      },
      {
        "type": "uiaRead",
        "label": "PC Medio",
        "name": "pcMedio"
      },
      {
        "type": "uiaRead",
        "label": "PC Ultimo",
        "name": "pcUltimo"
      },
      {
        "type": "uiaRead",
        "label": "Bloq.Venta",
        "self": true,
        "checkbox": true,
        "name": "bloqVentaChecked"
      },
      {
        "type": "screenshot",
        "name": "Price read screenshot"
      }
    ],
    "priceApplySteps": [
      {
        "type": "focus"
      },
      {
        "type": "uiaFocus",
        "label": "Bloq.Venta",
        "self": true
      },
      {
        "type": "conditionalKey",
        "if": "bloqVentaChecked",
        "keys": " ",
        "name": "Desmarcar solo si estaba marcado"
      },
      {
        "type": "uiaFocus",
        "label": "PC Medio"
      },
      {
        "type": "hotkey",
        "keys": "^a"
      },
      {
        "type": "typeText",
        "value": "{{pcMedio}}"
      },
      {
        "type": "uiaFocus",
        "label": "PC Ultimo"
      },
      {
        "type": "hotkey",
        "keys": "^a"
      },
      {
        "type": "typeText",
        "value": "{{pcUltimo}}"
      },
      {
        "type": "uiaFocus",
        "label": "P. defecto",
        "index": 1,
        "name": "Columna % (la 2ª a la derecha de la etiqueta)"
      },
      {
        "type": "hotkey",
        "keys": "^a"
      },
      {
        "type": "typeText",
        "value": "{{pDefecto}}"
      },
      {
        "type": "hotkey",
        "keys": "{TAB}",
        "name": "Salir del campo para confirmar el valor"
      },
      {
        "type": "wait",
        "ms": 300
      },
      {
        "type": "hotkey",
        "keys": "^s",
        "name": "Guardar = Ctrl+S"
      },
      {
        "type": "wait",
        "ms": 1500
      },
      {
        "type": "screenshot",
        "name": "Price changed screenshot"
      }
    ]
  },
  "webOrder": {
    "enabled": false,
    "debugUrl": "http://127.0.0.1:9222",
    "pageUrlIncludes": "unideges",
    "dumpFile": "order-page-dump.html",
    "formRenderMs": 2800,
    "autocompleteTimeoutMs": 5000,
    "autocompleteMs": 900,
    "betweenLinesMs": 400,
    "pageNavigationTimeoutMs": 20000,
    "pedidoListUrl": "",
    "maxSearchOptions": 20,
    "protocolTimeoutMs": 90000,
    "connectRetries": 3,
    "selectSettleMs": 500,
    "repairBlankLines": true,
    "nextFieldMs": 140
  }
}
